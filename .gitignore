# Per-machine files. Never tracked: they hold identity, tokens or host-specific
# paths. install.sh creates the ones it needs.
*.local
*.bak
.config/gh/hosts.yml

# Compiled form of the personal spell dictionary — Neovim regenerates it from
# the tracked .add file on first use, so it would only churn in diffs.
*.add.spl

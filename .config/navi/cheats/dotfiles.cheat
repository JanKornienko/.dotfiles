% dotfiles, modern-cli

# eza: long list with git status + icons
ll

# eza: show all (incl. hidden)
la

# eza: long list, all files, git status
lla

# eza: tree view (depth 2)
lt

# eza: tree view, all files + git status
lta

# zoxide: jump to a frecent directory by partial name
z <dir>

# zoxide: interactive directory picker (fzf)
zi

# thefuck: correct the previous mistyped command
fuck

% git, dotfiles

# git: undo last commit, keep changes staged
git reset --soft HEAD~1

# git: amend last commit (keep message)
git commit --amend --no-edit

# git: amend last commit, edit message
git commit --amend

# git: discard all uncommitted changes (DANGER)
git reset --hard HEAD

# git: unstage a file
git restore --staged <file>

# git: discard changes to a file
git restore <file>

# git: interactive diff with delta navigation (n/N to move)
git diff

# git: create and switch to a new branch
git switch -c <branch>

# git: stash current changes with a message
git stash push -m "<message>"

# git: list stashes
git stash list

# git: show last commit with stats
git show --stat HEAD

% tmux, dotfiles

# tmux: new named session
tmux new -s <name>

# tmux: attach to a session
tmux attach -t <name>

# tmux: list sessions
tmux ls

# tmux: kill a session
tmux kill-session -t <name>

% atuin, history

# atuin: search shell history (or press Ctrl-R)
atuin search <query>

# atuin: stats about your shell usage
atuin stats
